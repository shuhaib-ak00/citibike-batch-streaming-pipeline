# ============================================================
# Salin file ini menjadi `.env`, lalu isi nilainya.
# JANGAN commit `.env` (sudah di-ignore).
#
#   cp .env.example .env
# ============================================================

# ============================================================
# GCP
# ============================================================
GCP_PROJECT_ID=my-gcp-project
GCP_LOCATION=asia-southeast2

# Bucket datalake
GCS_BUCKET_RAW=citibike-raw-nama-kamu

# Dataset BigQuery diberi PREFIKS nama pemilik karena project GCP biasanya
# dipakai bersama peserta lain. Tanpa prefiks, dua orang bisa memakai nama
# dataset yang sama sehingga tabel saling tercampur dalam satu dataset.
#
# Menghasilkan dataset:
#   <nama>_citibike_raw          (raw layer)
#   <nama>_citibike_staging      (dbt)
#   <nama>_citibike_intermediate (dbt)
#   <nama>_citibike_marts        (dbt, core)
#   <nama>_citibike_dashboard    (dbt, BI-ready)
BQ_DATASET_RAW=nama_citibike_raw

# Dataset dasar dbt. Suffix layer (staging/intermediate/marts/dashboard)
# ditambahkan otomatis oleh macro generate_schema_name.
BQ_DATASET_DBT=nama_citibike

# Path service account DI DALAM container.
# Untuk run dbt lokal dari host, override ke path absolut file .json.
GOOGLE_APPLICATION_CREDENTIALS=/opt/airflow/.gcp/service-account.json

# ============================================================
# Airflow
# ============================================================
# Di Linux, set ke `id -u` agar file log tidak jadi milik root.
# Di Windows/macOS Docker Desktop boleh dibiarkan default.
AIRFLOW_UID=50000

# Wajib: generate dengan
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=GANTI_DENGAN_FERNET_KEY_ANDA

AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
# Opsional: Slack Incoming Webhook untuk alert kegagalan pipeline.
# Kosongkan bila tidak dipakai (alert tetap tercatat di log Airflow).
ALERT_WEBHOOK_URL=

# ------------------------------------------------------------
# Ambang & pembatas alert (opsional — semua punya nilai default).
# Ubah di sini lalu RECREATE container (`docker compose up -d`);
# `restart` tidak cukup karena variabel lingkungan hanya dibaca
# saat container dibuat.
# ------------------------------------------------------------
# Streaming watchdog
STREAMING_FRESHNESS_THRESHOLD_MINUTES=10
CONSUMER_LIVENESS_MINUTES=10
DLQ_WINDOW_MINUTES=30
DLQ_ALERT_ROWS=200
STREAMING_REJECTION_THRESHOLD_PCT=5

# Watchdog kegagalan DAG-run: seberapa jauh ke belakang dicari.
#
# Harus melebihi celah jadwal terpanjang yang mungkin terjadi, bukan sekadar
# jeda normal. Pernah ada celah ±3 jam karena stack sempat mati, dan kegagalan
# di dalamnya tidak pernah dilaporkan dengan nilai 60. Konsekuensinya satu run
# gagal terlihat selama 24 siklus watchdog, sehingga jendela dedup DAG-run di
# bawah harus >= nilai ini.
WATCHDOG_FAILED_RUN_LOOKBACK_MINUTES=240

# Pembatas Slack.
#
# ALERT_DEDUP_WINDOW_SECONDS berlaku untuk alert per task & peringatan
# watchdog. Nilainya sengaja tetap pendek: kekecualian hanya untuk ringkasan
# DAG-run, yang memakai ALERT_DAGRUN_DEDUP_WINDOW_SECONDS. Memisahkannya
# penting — menaikkan jendela global akan ikut menahan gangguan BARU pada
# pemeriksaan streaming yang sama.
ALERT_DEDUP_WINDOW_SECONDS=3600
ALERT_DAGRUN_DEDUP_WINDOW_SECONDS=14400
ALERT_MIN_INTERVAL_SECONDS=3
ALERT_BURST_WINDOW_SECONDS=60
ALERT_BURST_MAX_ALERTS=5


# ============================================================
# Postgres (metadata DB Airflow)
# ============================================================
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# ============================================================
# Citi Bike / GBFS
# ============================================================
GBFS_BASE_URL=https://gbfs.citibikenyc.com/gbfs/en
STATION_STATUS_URL=https://gbfs.citibikenyc.com/gbfs/en/station_status.json
STATION_INFORMATION_URL=https://gbfs.citibikenyc.com/gbfs/en/station_information.json

# Interval polling producer station_status, dalam detik (rentang wajar 60-120)
POLL_INTERVAL_SECONDS=90

# Batas waktu permintaan HTTP ke API GBFS, dalam detik
HTTP_TIMEOUT_SECONDS=20

# ============================================================
# Kafka
# ============================================================
# Nama host sesuai nama service di docker-compose (antar-container)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Untuk debug dari host (mis. kafka-console-consumer di mesin lokal)
KAFKA_BOOTSTRAP_SERVERS_HOST=localhost:29092

KAFKA_TOPIC_STATION_SNAPSHOT=citibike.station_status.snapshot
KAFKA_TOPIC_STATION_DLQ=citibike.station_status.dlq

# Port host untuk Kafka UI (http://localhost:<port>).
# Ubah bila 8081 sudah dipakai proses lain di mesin Anda.
KAFKA_UI_PORT=8081

# Nama consumer group yang menulis snapshot ke datalake/warehouse.
# Diubah hanya bila ingin memproses ulang seluruh riwayat dari awal,
# karena offset Kafka dihitung per group.
KAFKA_CONSUMER_GROUP=citibike-station-status-writer

# ----- Perilaku penulisan consumer -----
# Banyaknya pesan yang ditampung sebelum ditulis massal. Tulis massal jauh
# lebih efisien daripada satu load job per pesan.
CONSUMER_BATCH_SIZE=5000

# Batas tunggu bila buffer belum penuh, dalam detik. Penulisan terjadi
# ketika pesan berhenti mengalir selama rentang ini — sehingga data tidak
# mengendap, dan satu snapshot tetap tertulis utuh dalam satu berkas.
CONSUMER_FLUSH_SECONDS=30

# ============================================================
# Metabase
# ============================================================
MB_DB_TYPE=postgres
MB_DB_DBNAME=metabase
MB_DB_PORT=5432
MB_DB_USER=metabase
MB_DB_PASS=metabase
MB_DB_HOST=metabase-db
