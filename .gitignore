*.key

# ===== Data besar: jangan di-commit =====
*.csv
!data/sample/**
*.zip
# Folder data mentah tidak di-commit isinya, tetapi foldernya perlu tetap
# ada di repo agar `docker-compose.yml` (bind mount ./data/raw) tidak gagal
# pada clone segar. Tanpa pengecualian ini, `.gitkeep` ikut ter-ignore dan
# foldernya hilang dari repo.
data/raw/*
!data/raw/.gitkeep

